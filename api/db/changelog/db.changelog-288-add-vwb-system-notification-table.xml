<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">
  <changeSet author="yonghao" id="changelog-288-add-vwb-system-notification-table">
    <createTable tableName="vwb_system_notification">
      <column name="vwb_system_notification_id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <!-- The notification ID Verily Workbench assigned, needed to delete it there later -->
      <column name="vwb_notification_id" type="varchar(255)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="title" type="varchar(200)">
        <constraints nullable="false"/>
      </column>
      <column name="message" type="varchar(4000)">
        <constraints nullable="false"/>
      </column>
      <!-- BLOCKING or PASSIVE -->
      <column name="notification_type" type="varchar(20)">
        <constraints nullable="false"/>
      </column>
      <!-- INFO, WARNING or ERROR -->
      <column name="notification_priority" type="varchar(20)">
        <constraints nullable="false"/>
      </column>
      <!-- Null start time means the notification is shown immediately -->
      <column name="start_time" type="datetime"/>
      <!-- Null end time means the notification never expires -->
      <column name="end_time" type="datetime"/>
    </createTable>

    <comment>
      Records the Verily Workbench system notifications created from the All of Us admin banner
      page. Verily Workbench owns the notification itself; this table keeps the ID it assigned so
      admins can list what All of Us created and delete it again.
    </comment>
  </changeSet>
</databaseChangeLog>
