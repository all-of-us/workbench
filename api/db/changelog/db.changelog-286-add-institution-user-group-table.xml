<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">
  <changeSet author="dolbeew" id="changelog-286-add-institution-user-group-table">

    <createTable tableName="institution_user_group">
      <column name="institution_user_group_id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="institution_id" type="bigint">
        <constraints nullable="false" foreignKeyName="fk_institution_user_group" references="institution(institution_id)"/>
      </column>
      <column name="user_group" type="VARCHAR(80)">
        <constraints nullable="false"/>
      </column>
      <column name="access_tier_id" type="bigint"/>
    </createTable>
    <createIndex tableName="institution_user_group" indexName="fk_institution_user_group_idx" unique="false">
      <column name="institution_id"/>
    </createIndex>

    <addForeignKeyConstraint baseColumnNames="access_tier_id"
      baseTableName="institution_user_group"
      constraintName="fk_institution_user_group_tier"
      onDelete="CASCADE"
      referencedColumnNames="access_tier_id"
      referencedTableName="access_tier"/>

  </changeSet>
</databaseChangeLog>
