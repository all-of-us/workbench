<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

  <changeSet author="workbench" id="288-add-workspace-recovery-error-log-table">
    <createTable tableName="workspace_recovery_error_log">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="workspace_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="error_message" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="error_type" type="VARCHAR(255)"/>
      <column name="stack_trace" type="TEXT"/>
      <column name="created_time" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false" updatable="false"/>
      </column>
    </createTable>

    <createIndex tableName="workspace_recovery_error_log" indexName="idx_workspace_recovery_error_log_workspace_id">
      <column name="workspace_id"/>
    </createIndex>

    <createIndex tableName="workspace_recovery_error_log" indexName="idx_workspace_recovery_error_log_created_time">
      <column name="created_time"/>
    </createIndex>

    <addForeignKeyConstraint
      constraintName="fk_workspace_recovery_error_log_workspace"
      baseTableName="workspace_recovery_error_log"
      baseColumnNames="workspace_id"
      referencedTableName="workspace"
      referencedColumnNames="workspace_id"/>
  </changeSet>

</databaseChangeLog>

