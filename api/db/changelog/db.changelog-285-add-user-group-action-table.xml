<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">
    <changeSet author="dolbeew" id="changelog-285-add-user-group-action-table">
        <createTable tableName="user_group_action">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="institution_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="group_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="added_time" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="completed_time" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="action" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="user_group_action" indexName="idx_user_group_action_institution_status_time" unique="false">
            <column name="institution_id"/>
            <column name="status"/>
            <column name="added_time"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
