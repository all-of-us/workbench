<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet author="dolbeew" id="changelog-287-add-workspace-archive-retry-columns">
        <addColumn tableName="workspace_bucket_archive">
            <column name="last_retry_time" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="original_billing_account" type="varchar(128)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
